local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Window = Rayfield:CreateWindow({
    Name = "Leaf Collector",
    LoadingTitle = "Leaf Collector",
    LoadingSubtitle = "Auto Collect / TP to Sell",
    ConfigurationSaving = {
        Enabled = false
    }
})

local Tab = Window:CreateTab("Leaves", 4483362458)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local collecting = false
local tping = false

-- AUTO COLLECT (infinite loop)
Tab:CreateToggle({
    Name = "Auto Collect Leaves",
    CurrentValue = false,
    Flag = "AutoCollect",

    Callback = function(value)
        collecting = value

        if value then
            task.spawn(function()
                while collecting do
                    for i = 1, 50000 do
                        if not collecting then break end
                        ReplicatedStorage.Remotes.CollectLeaf:FireServer(i)
                        task.wait()
                    end
                    -- loops back to the for loop automatically
                end
            end)
        end
    end
})

-- TP TO SELL (only teleports)
Tab:CreateToggle({
    Name = "TP to Sell",
    CurrentValue = false,
    Flag = "TPSell",

    Callback = function(value)
        tping = value

        if value then
            task.spawn(function()
                while tping do
                    local character = Player.Character
                    local root = character and character:FindFirstChild("HumanoidRootPart")

                    if root then
                        root.CFrame = CFrame.new(56, 65, -50)
                    end

                    task.wait(1)
                end
            end)
        end
    end
})
